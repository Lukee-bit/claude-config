{
  "mcptoon": {
    "command": "__HOME__/.local/share/uv/tools/mcptoon/bin/python",
    "args": [
      "-m",
      "mcptoon",
      "serve"
    ]
  },
  "caveman": {
    "type": "stdio",
    "command": "__HOME__/.caveman/bin/caveman-mcp",
    "args": [],
    "env": {}
  },
  "lightpanda": {
    "command": "__HOME__/.local/bin/lightpanda",
    "args": [
      "mcp"
    ]
  },
  "github-direct": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
    }
  },
  "gitkraken": {
    "command": "npx",
    "args": [
      "-y",
      "@gitkraken/gk",
      "mcp",
      "--plugin",
      "--host=claude"
    ]
  }
}
