#!/bin/bash
# Per-project Agent-Fusion: config + duckdb in <project>/.agent/fusion, loopback only, port from path hash.
P="${CLAUDE_PROJECT_DIR:-$PWD}"
# Never watch a non-project location (a $HOME scan hit 1.2M files and stalled the server); use the small default vault instead.
case "$P" in "$HOME"|/|/tmp*|/private/*|"$HOME/Library"*|"$HOME/.claude"*|"$HOME/.local"*|"$HOME/.cache"*|"$HOME/Desktop"|"$HOME/Documents"|"$HOME/Downloads"|"$HOME/Projects") P="$HOME/.claude-tools/default-vault";; esac
AF="$HOME/.claude-tools/src/Agent-Fusion"; JAR="$HOME/.claude-tools/agent-fusion/orchestrator-0.1.0-all.jar"
JAVA=/opt/homebrew/opt/openjdk@21/bin/java
D="$P/.agent/fusion"; mkdir -p "$D"
H=$(printf %s "$P" | cksum | cut -d' ' -f1); PORT=$((31000 + H % 2000)); WEB=$((PORT + 2000))
if [ ! -f "$D/fusionagent.toml" ]; then
python3 - "$AF/fusionagent.toml" "$D/fusionagent.toml" "$P" "$PORT" "$WEB" "$D" <<'PY'
import re,sys
src,dst,proj,port,web,d=sys.argv[1:]
t=open(src).read()
t=re.sub(r'(\[orchestrator\.server\]\s*\nhost = "127\.0\.0\.1"\s*\nport = )\d+',r'\g<1>'+port,t,1)
t=re.sub(r'(\[web\]\s*\nhost = "127\.0\.0\.1"\s*\nport = )\d+',r'\g<1>'+web,t,1)
t=re.sub(r'(?m)^(ignore_patterns = \[\n)',r'\1    ".next/", ".obsidian/", ".codegraph/", "pnpm-lock.yaml", "package-lock.json", "yarn.lock", "*.lock", "*.map", "*.min.js", "*.tsbuildinfo", ".specify/", ".cache/", "coverage/", "__pycache__/", "out/",\n',t,1)
t=t.replace('git_intent_links = true','git_intent_links = false',1)  # its per-file rebuild fails (FK error) and delays the HTTP port by minutes
t=re.sub(r'db_path = "[^"]*"','db_path = "%s/context.duckdb"'%d,t,1)
t=re.sub(r'(?m)^watch_paths = \[[^\]]*\]','watch_paths = ["%s"]'%proj,t,1)
open(dst,'w').write(t)
PY
fi
if [ -f "$D/pid" ] && kill -0 "$(cat "$D/pid")" 2>/dev/null; then :; elif ! curl -s -m 2 -o /dev/null "http://127.0.0.1:$PORT/mcp/json-rpc" -d '{"jsonrpc":"2.0","id":0,"method":"ping"}' -H 'content-type: application/json'; then
  ( cd "$D" && nohup "$JAVA" -jar "$JAR" --agents "$D/fusionagent.toml" >>"$D/server.log" 2>&1 & echo $! >"$D/pid" )
  for i in $(seq 1 40); do curl -s -m 1 -o /dev/null "http://127.0.0.1:$PORT/mcp/json-rpc" -d '{"jsonrpc":"2.0","id":0,"method":"ping"}' -H 'content-type: application/json' && break; /bin/sleep 1; done
fi
MCP_ENDPOINT="http://127.0.0.1:$PORT/mcp/json-rpc" exec bash "$AF/orchestrator-mcp-proxy.sh"
