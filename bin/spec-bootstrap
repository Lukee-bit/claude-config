#!/usr/bin/env bash
# Scaffold spec-kit (.specify) and OpenSpec (openspec/) in the project dir if missing. Idempotent, never overwrites.
# Same project filter as vault-bootstrap. Opt out per project: touch .spec-bootstrap-off
set -u
dir="${1:-${CLAUDE_PROJECT_DIR:-$PWD}}"
dir="$(cd "$dir" 2>/dev/null && pwd -P)" || exit 0
home="$(cd ~ && pwd -P)"
case "$dir" in
  "$home"|/|/tmp*|/private/tmp*|/private/var*|/var/*|/usr*|/etc*|/System*|/Library*|/Applications*) exit 0;;
  "$home/Library"*|"$home/.claude"*|"$home/.claude-tools"*|"$home/.cache"*|"$home/.local"*|"$home/.npm"*) exit 0;;
  "$home/Desktop"|"$home/Documents"|"$home/Downloads"|"$home/Projects") exit 0;;
esac
[ -f "$dir/.spec-bootstrap-off" ] && exit 0
fresh=0; n=$(ls -A "$dir" 2>/dev/null | wc -l | tr -d ' ')
[ "$n" -le 3 ] && fresh=1
marker=0
for m in .git package.json pyproject.toml Cargo.toml go.mod CLAUDE.md AGENTS.md Makefile README.md; do [ -e "$dir/$m" ] && marker=1; done
[ $fresh -eq 0 ] && [ $marker -eq 0 ] && exit 0
cd "$dir" || exit 0
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
[ -d .specify ] || specify init --here --force --non-interactive --integration claude >/dev/null 2>&1
[ -d openspec ] || openspec init --tools claude >/dev/null 2>&1
exit 0
