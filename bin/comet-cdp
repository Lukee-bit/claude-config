#!/bin/sh
# Ensure Comet runs normally on the user's real profile with a debug port.
# Never launches Comet through automation flags, so the profile is not reset or modified.
PORT=9223
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) WIN=1;; *) WIN=0;; esac
if [ $WIN = 1 ]; then
  COMET="${COMET_EXE:-/c/Program Files/Perplexity/Comet/Application/comet.exe}"
  up() { curl -s -m 1 -o /dev/null "http://127.0.0.1:$PORT/json/version"; }
else
  up() { nc -z 127.0.0.1 $PORT 2>/dev/null; }
fi
if ! up; then
  if [ $WIN = 1 ]; then
    if tasklist 2>/dev/null | grep -qi '^comet.exe'; then
      echo "Comet is running without a debug port. Quit Comet completely (tray icon > Exit) and retry; it will relaunch with port $PORT." >&2; exit 1
    fi
    ( nohup "$COMET" --remote-debugging-port=$PORT >/dev/null 2>&1 & )
  else
    if pgrep -x Comet >/dev/null; then
      echo "Comet is running without a debug port. Quit Comet (Cmd+Q) and retry; it will relaunch with port $PORT." >&2; exit 1
    fi
    open -a Comet --args --remote-debugging-port=$PORT
  fi
  for i in $(seq 1 30); do up && break; sleep 1; done
fi
up || { echo "Comet debug port $PORT did not come up" >&2; exit 1; }
